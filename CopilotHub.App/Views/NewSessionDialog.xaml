<Window x:Class="CopilotHub.App.Views.NewSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Copilot Session" Height="340" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="CaretBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Working Directory" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DirectoryBox" Grid.Column="0" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,4"
                        Background="#3C3C3C" Foreground="#CCC" BorderBrush="#555"
                        Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Model" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModelBox" IsEditable="True">
                <ComboBoxItem Content="claude-opus-4.6" IsSelected="True"/>
                <ComboBoxItem Content="claude-opus-4.6-fast"/>
                <ComboBoxItem Content="claude-opus-4.5"/>
                <ComboBoxItem Content="claude-sonnet-4"/>
                <ComboBoxItem Content="claude-haiku-4.5"/>
                <ComboBoxItem Content="gpt-5.3-codex"/>
                <ComboBoxItem Content="gpt-5.2-codex"/>
                <ComboBoxItem Content="gpt-5.1-codex"/>
                <ComboBoxItem Content="gpt-5"/>
                <ComboBoxItem Content="gemini-3-pro-preview"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Extra Copilot Arguments" FontWeight="SemiBold"/>
            <TextBox x:Name="ExtraArgsBox" Text="--allow-all"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Session Name (optional)" FontWeight="SemiBold"/>
            <TextBox x:Name="SessionNameBox"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="20,6" Margin="0,0,8,0"
                    Background="#3C3C3C" Foreground="#CCC" BorderBrush="#555"
                    IsCancel="True"/>
            <Button Content="Create Session" Padding="20,6"
                    Background="#0078D4" Foreground="White" BorderBrush="#0078D4"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
