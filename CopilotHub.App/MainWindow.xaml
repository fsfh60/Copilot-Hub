<Window x:Class="CopilotHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotHub.App.ViewModels"
        xmlns:controls="clr-namespace:CopilotHub.App.Controls"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CopilotHub" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{Binding Theme.WindowBg}"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Session toolbar -->
        <Border Grid.Row="0" Background="{Binding Theme.PanelBg}" Padding="6,4">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="＋ New Session" Command="{Binding NewSessionCommand}"
                        Padding="14,6" Cursor="Hand" FontWeight="SemiBold"
                        Background="{Binding Theme.AccentBrush}" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Session tab buttons -->
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Sessions}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                            <Border Margin="2,0" Padding="10,4" CornerRadius="4" Cursor="Hand"
                                    BorderThickness="1" MouseLeftButtonDown="SessionTab_Click"
                                    BorderBrush="{Binding DataContext.Theme.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding Session.Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.Theme.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text=" ●" Foreground="#FFA726" FontSize="10" VerticalAlignment="Center"
                                               Visibility="{Binding HasFileIndicator, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="✕" Margin="8,0,0,0" Padding="4,0" FontSize="11"
                                            Cursor="Hand" VerticalAlignment="Center"
                                            Background="Transparent" Foreground="{Binding DataContext.Theme.DimForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Row 1: Console type selector (hidden until a session is active) -->
        <Border Grid.Row="1" Background="{Binding Theme.SurfaceBg}" Padding="6,3"
                BorderBrush="{Binding Theme.BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbCopilot" GroupName="ConsoleType" Content="🤖 Copilot" IsChecked="True"
                             Foreground="{Binding Theme.Foreground}" Margin="0,0,4,0"
                             Padding="10,4" Cursor="Hand" Checked="ConsoleType_Checked" Tag="Copilot">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="RbCmd" GroupName="ConsoleType" Content="⬛ CMD"
                             Foreground="{Binding Theme.Foreground}" Margin="0,0,4,0"
                             Padding="10,4" Cursor="Hand" Checked="ConsoleType_Checked" Tag="Cmd">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="RbPs" GroupName="ConsoleType" Content="🔷 PowerShell"
                             Foreground="{Binding Theme.Foreground}" Margin="0,0,4,0"
                             Padding="10,4" Cursor="Hand" Checked="ConsoleType_Checked" Tag="PowerShell">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <!-- Working directory display -->
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Theme.DimForeground}"
                           FontFamily="Cascadia Code,Consolas" FontSize="12"
                           Text="{Binding SelectedSession.Session.WorkingDirectory}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Main content (console + files panel) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Native console host (persistent, single instance — we swap console windows) -->
            <controls:NativeConsoleHost Grid.Column="0" x:Name="ConsoleHost"/>

            <!-- File editor overlay (shown when editing a file) -->
            <Grid Grid.Column="0" x:Name="FileEditorPanel" Visibility="Collapsed"
                  Background="{Binding Theme.WindowBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Top bar: back button + file tabs -->
                <Border Grid.Row="0" Background="{Binding Theme.PanelBg}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="◀ Back" Margin="4,2" Padding="8,4" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{Binding Theme.AccentBrush}"
                                Click="BackToConsole_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Open file tabs -->
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SelectedSession.OpenFiles}" Margin="4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OpenFileTab}">
                                    <Border Margin="1,2" Padding="8,3" CornerRadius="3" Cursor="Hand"
                                            MouseLeftButtonDown="FileTab_Click"
                                            BorderThickness="1"
                                            BorderBrush="{Binding DataContext.Theme.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.Theme.Foreground, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12"/>
                                            <TextBlock Text=" •" Foreground="#FFA726" FontSize="12" VerticalAlignment="Center"
                                                       Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="✕" Margin="6,0,0,0" Padding="3,0" FontSize="10"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{Binding DataContext.Theme.DimForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.SelectedSession.CloseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <!-- Edit/Diff mode toggle -->
                <Border Grid.Row="1" Background="{Binding Theme.SurfaceBg}" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📝 Edit" Margin="0,0,4,0" Padding="10,3" Cursor="Hand"
                                Click="ShowEditView_Click"
                                Foreground="{Binding Theme.Foreground}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                            Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.ButtonHoverBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="📊 Diff" Padding="10,3" Cursor="Hand"
                                Click="ShowDiffView_Click"
                                Foreground="{Binding Theme.Foreground}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                            Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.ButtonHoverBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="💾 Save" Margin="16,0,0,0" Padding="10,3" Cursor="Hand"
                                Foreground="{Binding Theme.Foreground}" BorderThickness="0"
                                Command="{Binding SelectedSession.SaveFileCommand}"
                                CommandParameter="{Binding SelectedSession.SelectedFile}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                            Background="{Binding DataContext.Theme.ButtonBg, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.Theme.ButtonHoverBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Theme.DimForeground}" FontSize="11"
                                   Text="{Binding SelectedSession.SelectedFile.RelativePath}"/>
                    </StackPanel>
                </Border>
                <!-- Editor content area -->
                <Grid Grid.Row="2">
                    <!-- AvalonEdit editor (shown in Edit mode) -->
                    <avalonEdit:TextEditor x:Name="AvalonEditor"
                                           FontFamily="Cascadia Code,Consolas,Courier New" FontSize="13"
                                           Background="{Binding Theme.EditorBg}"
                                           Foreground="{Binding Theme.Foreground}"
                                           ShowLineNumbers="True"
                                           WordWrap="True"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           BorderThickness="0" Padding="4"/>
                    <!-- Diff view (shown in Diff mode) -->
                    <Grid x:Name="DiffViewPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Original (HEAD) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{Binding Theme.PanelBg}" Padding="8,4">
                                <TextBlock Text="Original (HEAD)" Foreground="{Binding Theme.DimForeground}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <avalonEdit:TextEditor x:Name="DiffOriginalEditor" Grid.Row="1"
                                                   FontFamily="Cascadia Code,Consolas,Courier New" FontSize="13"
                                                   Background="{Binding Theme.EditorBg}"
                                                   Foreground="{Binding Theme.DimForeground}"
                                                   ShowLineNumbers="True" IsReadOnly="True"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   BorderThickness="0" Padding="4"/>
                        </Grid>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="{Binding Theme.BorderBrush}"/>
                        <!-- Modified (current) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{Binding Theme.PanelBg}" Padding="8,4">
                                <TextBlock Text="Modified (current)" Foreground="{Binding Theme.DimForeground}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <avalonEdit:TextEditor x:Name="DiffModifiedEditor" Grid.Row="1"
                                                   FontFamily="Cascadia Code,Consolas,Courier New" FontSize="13"
                                                   Background="{Binding Theme.EditorBg}"
                                                   Foreground="{Binding Theme.Foreground}"
                                                   ShowLineNumbers="True" IsReadOnly="True"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   BorderThickness="0" Padding="4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Placeholder when no session -->
            <TextBlock Grid.Column="0" x:Name="NoSessionPlaceholder"
                       Text="Click '＋ New Session' to start a Copilot session"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding Theme.DimForeground}" FontSize="16"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="{Binding Theme.BorderBrush}"/>

            <!-- Right panel: Modified Files -->
            <Border Grid.Column="2" Background="{Binding Theme.SurfaceBg}"
                    BorderBrush="{Binding Theme.BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Background="{Binding Theme.PanelBg}">
                        <TextBlock Text="Modified Files" Foreground="{Binding Theme.Foreground}"
                                   FontWeight="SemiBold" Padding="10,8,10,2"/>
                        <TextBlock Text="{Binding SelectedSession.Session.WorkingDirectory}"
                                   Foreground="{Binding Theme.DimForeground}" Padding="10,0,10,6"
                                   FontFamily="Cascadia Code,Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedSession.ModifiedFiles}"
                             Background="{Binding Theme.SurfaceBg}"
                             Foreground="{Binding Theme.Foreground}" BorderThickness="0"
                             FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Cursor="Hand" Padding="6,3">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.ViewFileDiffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
